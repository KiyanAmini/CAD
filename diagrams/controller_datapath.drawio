"1550" y="100"/></Array></mxGeometry></mxCell><mxCell id="n1" value="Notes for the drawing (match the RTL):&lt;br&gt;1. Weights do NOT go straight from weight_sram to the multiplier: they pass through the controller's staging registers sel_r (needed to gather FC2 weights from two physical rows).&lt;br&gt;2. The multiplier operand MUX (fc2_mode) selects pixels (layer 1) or hidden values (layer 2); fc2_mode is set by argmax_start.&lt;br&gt;3. bias_latched is loaded when bias_valid; it is the accumulator start value.&lt;br&gt;4. relu is used only after layer 1; layer-2 results go straight to argmax (logit_in = accumulator result_out).&lt;br&gt;5. Address mapping: FC1 row = nidx*112 + gidx; FC2 row = 896 + floor((8*didx + h)/7), lane = (8*didx + h) mod 7 (h=0..6 in group 0, h=7 in group 1 with lane_valid = 0000001).&lt;br&gt;6. Exactly ONE multiplier and ONE adder in the whole design." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1500" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Controller FSM" id="fsm"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="IDLE" value="1. IDLE&lt;br&gt;wait for start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_BIAS_REQ" value="2. FC1_BIAS_REQ&lt;br&gt;bias_read_req, addr=nidx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_BIAS_WAIT" value="3. FC1_BIAS_WAIT&lt;br&gt;wait bias_valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_INPUT_WEIGHT_REQ" value="4. FC1_INPUT_WEIGHT_REQ&lt;br&gt;input_read_req + weight_read_req&lt;br&gt;row = nidx*112 + gidx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_OPERAND_WAIT" value="5. FC1_OPERAND_WAIT&lt;br&gt;wait in_seen &amp; wt_seen&lt;br&gt;&amp; buffer_write_ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_MAC_START" value="6. FC1_MAC_START&lt;br&gt;multiplier_start&lt;br&gt;acc_start if gidx==0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_GROUP_WAIT" value="7. FC1_GROUP_WAIT&lt;br&gt;wait buffer_full" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_CONSUME_WAIT" value="8. FC1_CONSUME_WAIT&lt;br&gt;buffer_consume_start&lt;br&gt;neuron_last if gidx==111" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_RESULT_WAIT" value="9. FC1_RESULT_WAIT&lt;br&gt;wait accumulator_result_valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC1_RELU_STORE" value="10. FC1_RELU_STORE&lt;br&gt;hidden_write_en" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_ARGMAX_START" value="11. FC2_ARGMAX_START&lt;br&gt;argmax_start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_BIAS_REQ" value="12. FC2_BIAS_REQ&lt;br&gt;bias_read_req, addr=8+didx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_BIAS_WAIT" value="13. FC2_BIAS_WAIT&lt;br&gt;wait bias_valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="620" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_GROUP_PREP" value="14. FC2_GROUP_PREP&lt;br&gt;layer2_group_read_req + weight_read_req&lt;br&gt;row = 896 + floor((8*didx+7*fgroup)/7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="620" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_GATHER_WAIT" value="15. FC2_GATHER_WAIT&lt;br&gt;gather lanes (&lt;= 2 rows)&lt;br&gt;wait hidden_seen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_OPERAND_WAIT" value="16. FC2_OPERAND_WAIT&lt;br&gt;wait lanes ok &amp; buffer_write_ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_MAC_START" value="17. FC2_MAC_START&lt;br&gt;multiplier_start&lt;br&gt;acc_start if fgroup==0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="790" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_GROUP_WAIT" value="18. FC2_GROUP_WAIT&lt;br&gt;wait buffer_full" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="790" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_CONSUME_WAIT" value="19. FC2_CONSUME_WAIT&lt;br&gt;buffer_consume_start&lt;br&gt;neuron_last if fgroup==1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="790" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_RESULT_WAIT" value="20. FC2_RESULT_WAIT&lt;br&gt;wait accumulator_result_valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="790" width="220" height="70" as="geometry"/></mxCell><mxCell id="FC2_LOGIT_SEND" value="21. FC2_LOGIT_SEND&lt;br&gt;argmax_logit_valid, index=didx&lt;br&gt;last if didx==9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="960" width="220" height="70" as="geometry"/></mxCell><mxCell id="COMPLETE_WAIT" value="22. COMPLETE_WAIT&lt;br&gt;wait argmax_done; done=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="960" width="220" height="70" as="geometry"/></mxCell><mxCell id="ft" value="controller_fsm - state diagram (22 states). Reset (rst=1, synchronous) forces IDLE and clears all counters. Wait states loop on themselves until their condition is true." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1400" height="30" as="geometry"/></mxCell><mxCell id="efsm2" value="start (only while idle)&lt;br&gt;clear nidx,gidx,didx,fgroup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="IDLE" target="FC1_BIAS_REQ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_BIAS_REQ" target="FC1_BIAS_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm4" value="bias_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_BIAS_WAIT" target="FC1_INPUT_WEIGHT_REQ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_INPUT_WEIGHT_REQ" target="FC1_OPERAND_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm6" value="in_seen &amp;&amp; wt_seen&lt;br&gt;&amp;&amp; buffer_write_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_OPERAND_WAIT" target="FC1_MAC_START"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm7" value="!multiplier_busy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_MAC_START" target="FC1_GROUP_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm8" value="buffer_full" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_GROUP_WAIT" target="FC1_CONSUME_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm9" value="valid&amp;ready&amp;last&lt;br&gt;&amp;&amp; gidx==111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_CONSUME_WAIT" target="FC1_RESULT_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm10" value="valid&amp;ready&amp;last &amp;&amp; gidx&lt;111  (gidx++)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="FC1_CONSUME_WAIT" target="FC1_INPUT_WEIGHT_REQ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="315.0"/><mxPoint x="30" y="50"/><mxPoint x="1110.0" y="50"/></Array></mxGeometry></mxCell><mxCell id="efsm11" value="accumulator_result_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_RESULT_WAIT" target="FC1_RELU_STORE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm12" value="nidx==7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC1_RELU_STORE" target="FC2_ARGMAX_START"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm13" value="nidx&lt;7  (nidx++, gidx=0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="FC1_RELU_STORE" target="FC1_BIAS_REQ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510.0" y="400"/><mxPoint x="360" y="400"/><mxPoint x="360" y="128"/></Array></mxGeometry></mxCell><mxCell id="efsm14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_ARGMAX_START" target="FC2_BIAS_REQ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_BIAS_REQ" target="FC2_BIAS_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm16" value="bias_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_BIAS_WAIT" target="FC2_GROUP_PREP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_GROUP_PREP" target="FC2_GATHER_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm18" value="gather_mask==need_mask&lt;br&gt;&amp;&amp; hidden_seen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_GATHER_WAIT" target="FC2_OPERAND_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm19" value="lanes ok &amp;&amp; hidden_seen&lt;br&gt;&amp;&amp; buffer_write_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_OPERAND_WAIT" target="FC2_MAC_START"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm20" value="!multiplier_busy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_MAC_START" target="FC2_GROUP_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm21" value="buffer_full" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_GROUP_WAIT" target="FC2_CONSUME_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm22" value="valid&amp;ready&amp;last&lt;br&gt;&amp;&amp; fgroup==1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_CONSUME_WAIT" target="FC2_RESULT_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm23" value="valid&amp;ready&amp;last &amp;&amp; fgroup==0&lt;br&gt;(fgroup becomes 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="FC2_CONSUME_WAIT" target="FC2_GROUP_PREP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm24" value="accumulator_result_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_RESULT_WAIT" target="FC2_LOGIT_SEND"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm25" value="didx==9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FC2_LOGIT_SEND" target="COMPLETE_WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="efsm26" value="didx&lt;9  (didx++, fgroup=0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="FC2_LOGIT_SEND" target="FC2_BIAS_REQ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="995.0"/><mxPoint x="1280" y="485.0"/></Array></mxGeometry></mxCell><mxCell id="efsm27" value="argmax_done  -&gt;  done = 1 (one cycle)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entry